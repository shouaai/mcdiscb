# mcdiscb settings. ./setup.sh fills in the important ones for you.
# Keep this file private (it holds bot tokens): chmod 600 .env

# ── Manager bot (the one with /start /stop) ─────────────────────────
DISCORD_TOKEN=
# Your Discord server ID - makes slash commands show up instantly
GUILD_ID=
# Your user ID(s), comma-separated. Admins can use /console and /logs and skip
# the "players are online, stop anyway?" prompt. Discord server admins count too.
ADMIN_USER_IDS=
# Optional: channel for crash / auto-stop / host-shutdown notices
STATUS_CHANNEL_ID=
# Optional: only allow /start /stop /restart in this channel
COMMAND_CHANNEL_ID=
# Optional: only members with this role can /start /stop /restart (empty = everyone)
ALLOWED_ROLE_ID=

# ── Minecraft ───────────────────────────────────────────────────────
# auto = newest stable Paper that DiscordSRV + AuthMe both support (used on first install)
MC_VERSION=auto
# RAM for the server (e.g. 4G, 6G, 3072M)
MEMORY=4G
# Leave empty to use /usr/lib/jvm/java-25-openjdk/bin/java
JAVA_BIN=
# Seconds to wait for the server to finish booting
START_TIMEOUT=300
# Seconds of in-game warning before /stop (only when players are online)
STOP_COUNTDOWN=10
# Stop automatically after N minutes with nobody online (0 = never)
AUTO_STOP_EMPTY_MINUTES=0
# Your email or GitHub URL - PaperMC's download API wants a contact in the User-Agent
CONTACT=

# ── playit.gg ───────────────────────────────────────────────────────
# Public address from the playit dashboard, e.g. something.joinmc.link
PLAYIT_ADDRESS=
PLAYIT_ENABLED=true
PLAYITD_BIN=/opt/playit/playitd
PLAYIT_CLI_BIN=/opt/playit/agent

# ── DiscordSRV chat bridge (must be a SEPARATE bot application) ─────
DISCORDSRV_BOT_TOKEN=
# Channel where Minecraft chat <-> Discord chat is mirrored
DISCORDSRV_CHAT_CHANNEL_ID=
# Optional: channel that mirrors the server console (keep it private!)
DISCORDSRV_CONSOLE_CHANNEL_ID=
# true = DiscordSRV only posts chat + join/leave (no advancements, deaths, start/stop,
# watchdog pings or channel-topic edits). Re-applied on every /start. false = DiscordSRV defaults.
DISCORDSRV_ONLY_CHAT=true
